GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# JWT_SECRET: Secret key for signing JWT authentication tokens
JWT_SECRET="fintech_secret_key_2026_change_in_production"

# MONGODB_URI: Optional MongoDB Atlas connection string (e.g. mongodb+srv://user:pass@cluster.mongodb.net/Fintech_AI?retryWrites=true&w=majority)
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-url>/Fintech_AI?retryWrites=true&w=majority"

# Optional database name for MongoDB Atlas
MONGODB_DB_NAME="Fintech_AI"
